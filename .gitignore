# ===================================
# 大文件：数据集和模型
# ===================================

# 数据集目录（保留目录结构说明文件）
data/
!data/.gitkeep
!data/README.md

# 检查点目录（保留目录结构说明文件）
checkpoints/
!checkpoints/.gitkeep
!checkpoints/README.md

# 实验结果（保留核心结果的配置和报告）
# 注意：忽略文件而非目录本身，否则后面的反白规则不生效
results/**
!results/**/
!results/.gitkeep
!results/README.md
!results/**/*.md
!results/**/*.txt
!results/**/*.json
!results/**/*.yaml

# 归档目录
archive/

